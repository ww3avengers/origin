# v0.8.0-rc1

# Base node image with pnpm
FROM node:20-alpine AS builder

# Install system dependencies and pnpm
RUN apk add --no-cache jemalloc python3 py3-pip uv build-base git \
    && npm install -g pnpm \
    && pnpm config set store-dir /root/.local/share/pnpm/store \
    && pnpm config set state-dir /root/.local/share/pnpm/state

# Enable pnpm strict-peer-dependencies
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# Set environment variable to use jemalloc
ENV LD_PRELOAD=/usr/lib/libjemalloc.so.2

# Add `uv` for extended MCP support
COPY --from=ghcr.io/astral-sh/uv:0.6.13 /uv /uvx /bin/
RUN uv --version

# Create app directory
WORKDIR /app

# Copy package files and source
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/api/package.json ./packages/api/
COPY packages/client/ ./packages/client/

# Install root dependencies
RUN pnpm install --prod false

# Install client dependencies and build
WORKDIR /app/packages/client
RUN pnpm install --prod false
# Ensure Vite and related dependencies are installed
RUN pnpm add -D vite @vitejs/plugin-react @vitejs/plugin-vue fs-extra
# Ensure build directory exists
RUN mkdir -p /app/packages/client/dist
# Build the client
RUN pnpm run build

# Install API dependencies
WORKDIR /app/packages/api
RUN pnpm install --prod false
# Build the API package
WORKDIR /app/packages/api
# Kopiere die Rollup-Konfiguration in das aktuelle Verzeichnis
COPY packages/api/rollup.config.js ./
# Führe den Build mit explizitem Pfad zur Konfigurationsdatei aus
RUN if grep -q '"build"' package.json; then pnpm run build -- --config rollup.config.js; else echo "No build script found in packages/api/package.json, skipping build"; fi

# Go back to root
WORKDIR /app

# Production stage
FROM node:20-alpine

# Install system dependencies
RUN apk add --no-cache jemalloc \
    && npm install -g pnpm \
    && pnpm config set store-dir /root/.local/share/pnpm/store \
    && pnpm config set state-dir /root/.local/share/pnpm/state

ENV LD_PRELOAD=/usr/lib/libjemalloc.so.2

# Create app directory
WORKDIR /app

# Copy built files from builder
COPY --from=builder /app/node_modules ./node_modules
# Copy API and client build artifacts
COPY --from=builder /app/packages/api ./packages/api
COPY --from=builder /app/packages/client/dist ./packages/client/dist

# Create necessary directories
RUN mkdir -p /app/packages/client/public/images /app/packages/api/logs

# Set environment variables
ENV NODE_ENV=production
ENV HOST=0.0.0.0
EXPOSE 3080

# Set working directory to API
WORKDIR /app/packages/api

# Set NODE_PATH to include node_modules
ENV NODE_PATH=/app/node_modules

# Start the application
CMD ["node", "server/index.js"]

# Optional: for client with nginx routing
# FROM nginx:stable-alpine AS nginx-client
# WORKDIR /usr/share/nginx/html
# COPY --from=node /app/client/dist /usr/share/nginx/html
# COPY client/nginx.conf /etc/nginx/conf.d/default.conf
# ENTRYPOINT ["nginx", "-g", "daemon off;"]